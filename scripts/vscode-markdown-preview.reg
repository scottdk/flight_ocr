Windows Registry Editor Version 5.00

; Add VS Code Markdown Preview to right-click context menu
; Double-click this .reg file to install

[HKEY_CLASSES_ROOT\.md]
@="MarkdownFile"

[HKEY_CLASSES_ROOT\MarkdownFile]
@="Markdown Document"

[HKEY_CLASSES_ROOT\MarkdownFile\shell]

[HKEY_CLASSES_ROOT\MarkdownFile\shell\vscode_preview]
@="Preview in VS Code"
"Icon"="C:\\Users\\scott\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe,0"

[HKEY_CLASSES_ROOT\MarkdownFile\shell\vscode_preview\command]
@="\"C:\\Users\\scott\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe\" \"%1\" --command \"markdown.showPreviewToSide\""
